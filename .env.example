# ==========================================
# CONFIGURAÇÕES GERAIS DO SISTEMA
# ==========================================
TZ=America/Sao_Paulo

# ==========================================
# NEXTCLOUD & MARIADB
# ==========================================
MYSQL_ROOT_PASSWORD=sua_senha_root_segura
MYSQL_PASSWORD=sua_senha_usuario_segura
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# Portas
NEXTCLOUD_PORT=8080

# ==========================================
# PORTAINER
# ==========================================
PORTAINER_PORT=9443

# ==========================================
# AIOSTREAMS
# ==========================================
AIOSTREAMS_PORT=8000
AIOSTREAMS_BASE_URL=http://SEU_IP_LOCAL:8000
AIOSTREAMS_SECRET_KEY=sua_chave_secreta_aqui
AIOSTREAMS_CONFIG_PATH=./config/aiostreams
