# ==========================================
# CONFIGURAÇÕES GERAIS DO SISTEMA
# ==========================================
TZ=America/Sao_Paulo

# ==========================================
# NEXTCLOUD & MARIADB
# ==========================================
MYSQL_ROOT_PASSWORD=sua_senha_root_segura
MYSQL_PASSWORD=sua_senha_usuario_segura
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# Portas
NEXTCLOUD_PORT=8080

# ==========================================
# PORTAINER
# ==========================================
PORTAINER_PORT=9443

# ==========================================
# AIOSTREAMS
# ==========================================
AIOSTREAMS_PORT=8000
AIOSTREAMS_BASE_URL=http://SEU_IP_LOCAL:8000
AIOSTREAMS_SECRET_KEY=sua_chave_secreta_aqui
AIOSTREAMS_CONFIG_PATH=./config/aiostreams

# ==========================================
# GERAL - IP FIXO DO SERVIDOR NA REDE LOCAL
# (usado pelo Pi-hole para os domínios *.home)
# ==========================================
SERVER_IP=192.168.1.100

# ==========================================
# IMMICH
# ==========================================
IMMICH_VERSION=v3
IMMICH_PORT=2283
# Caminhos relativos à pasta immich/
IMMICH_UPLOAD_LOCATION=./library
IMMICH_DB_LOCATION=./postgres
# Use apenas letras e números (A-Za-z0-9), sem espaços ou símbolos
DB_PASSWORD=troque_esta_senha
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ==========================================
# PI-HOLE
# ==========================================
PIHOLE_WEB_PORT=8081
PIHOLE_PASSWORD=sua_senha_pihole

# ==========================================
# NGINX PROXY MANAGER
# ==========================================
NPM_ADMIN_PORT=81
